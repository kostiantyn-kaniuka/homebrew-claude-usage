#!/bin/bash
# claude-usage — install/remove the Claude Usage desktop widget built by Homebrew.
set -euo pipefail

SRC_APP="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/ClaudeUsage.app"
DEST_DIR="$HOME/Applications"
DEST_APP="$DEST_DIR/ClaudeUsage.app"
DATA_DIR="$HOME/Library/Application Support/ClaudeUsageWidget"

case "${1:-help}" in
  install)
    [ -d "$SRC_APP" ] || { echo "App not found at $SRC_APP" >&2; exit 1; }
    pkill -x ClaudeUsage 2>/dev/null && sleep 1 || true
    mkdir -p "$DEST_DIR"
    rm -rf "$DEST_APP"
    cp -R "$SRC_APP" "$DEST_APP"
    open "$DEST_APP"
    killall chronod 2>/dev/null || true   # make the widget gallery pick up the new version
    echo "Installed to $DEST_APP and started (look for ✱ in the menu bar)."
    echo "Add the widget: right-click desktop → Edit Widgets… → search \"Claude Usage\"."
    ;;
  uninstall)
    pkill -x ClaudeUsage 2>/dev/null || true
    rm -rf "$DEST_APP" "$DATA_DIR"
    echo "Removed. Also remove the widget from your desktop, and \"ClaudeUsage\" from"
    echo "System Settings → General → Login Items if it is still listed."
    ;;
  *)
    echo "Usage: claude-usage install | uninstall"
    ;;
esac
